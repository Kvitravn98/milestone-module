<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_project_csv_export_wizard_form" model="ir.ui.view">
        <field name="name">project.csv.export.wizard.form</field>
        <field name="model">project.csv.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Project CSV">
                <sheet>
                    <group>
                        <field name="project_id"/>
                        <field name="export_milestones"  widget="boolean_toggle" string="Export Milestones"/>
                        <field name="export_tasks"  widget="boolean_toggle" string="Export Tasks"/>
                        <field name="export_team_members"  widget="boolean_toggle" string="Export Team Members"/>
                    </group>
                </sheet>

                <footer>
                    <button
                        name="action_export_wizard"
                        type="object"
                        string="Export"
                        class="btn-primary"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_csv_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Project CSV</field>
        <field name="res_model">project.csv.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_project_csv_export_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>