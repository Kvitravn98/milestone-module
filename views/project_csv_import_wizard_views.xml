<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_project_csv_import_wizard" model="ir.ui.view">
        <field name="name">project.csv.import.wizard.form</field>
        <field name="model">project.csv.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="project_id"/>
                        <field name="csv_file" filename="filename" options="{'accepted_file_extensions': '.csv'}"/>
                        <field name="filename" invisible="1"/>
                        <field name="import_milestones" type="boolean_toggle" default="True" string="Import Milestones"/>
                        <field name="import_team_members" type="boolean_toggle" default="True" string="Import Team Members"/>
                    </group>
                </sheet>
                <footer>
                    <div class="alert alert-warning" role="alert"
                         invisible="import_milestones or import_team_members">
                        Please select at least one import option.
                    </div>
                    <group>
                        <button
                            type="object"
                            name="action_import_csv"
                            string="Import"
                            class="btn-primary"
                            invisible="not import_milestones and not import_team_members"
                        />
                        <button
                            string="Cancel"
                            special="cancel"
                        />
                    </group>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_csv_import_wizard" model="ir.actions.act_window">
        <field name="name">Import CSV</field>
        <field name="res_model">project.csv.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_project_csv_import_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>