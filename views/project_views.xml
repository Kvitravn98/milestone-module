<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_project_form_inherit_milestones_team" model="ir.ui.view">
        <field name="name">project.project.form.inherit.milestones.team</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook/page[@name='description']" position="after">

                <page name="custom_milestones" string="Milestones">
                    <group string="Milestone Summary">
                        <group>
                            <field name="custom_milestone_count" readonly="1"/>
                            <field name="custom_completed_milestone_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="custom_milestone_progress"
                                   readonly="1"
                                   widget="progressbar"/>
                        </group>
                    </group>

                    <field name="milestone_ids"
                           mode="list,form"
                           context="{'default_project_id': id}">
                        <list>
                            <field name="name"/>
                            <field name="deadline"/>
                            <field name="state"/>
                            <field name="task_count" readonly="1"/>
                        </list>
                    </field>
                </page>

                <page name="team_allocation" string="Team Allocation">
                    <field name="team_member_ids"
                           mode="list,form"
                           context="{'default_project_id': id}">
                        <list>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="role"/>
                            <field name="task_count" readonly="1"/>
                            <field name="active"/>
                        </list>
                    </field>
                </page>

            </xpath>

        </field>
    </record>

</odoo>