<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Milestone List View -->
    <record id="view_project_milestone_list_custom" model="ir.ui.view">
        <field name="name">project.milestone.list.custom</field>
        <field name="model">project.milestone</field>
        <field name="arch" type="xml">
            <list string="Milestones">
                <field name="name"/>
                <field name="project_id"/>
                <field name="deadline"/>
                <field name="state"/>
                <field name="assigned_task_count"/>
            </list>
        </field>
    </record>

    <!-- Milestone Form View -->
    <record id="view_project_milestone_form_custom" model="ir.ui.view">
        <field name="name">project.milestone.form.custom</field>
        <field name="model">project.milestone</field>
        <field name="arch" type="xml">
            <form string="Milestone">
                <header>
                    <button
                        name="action_open_assign_tasks_wizard"
                        type="object"
                        string="Assign Tasks"
                        class="btn-primary"
                        invisible="not id"
                    />
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="deadline"/>
                            <field name="state"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Assigned Tasks">
                            <field name="task_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="project_id"/>
                                    <field name="user_ids" widget="many2many_avatar_user"/>
                                    <field name="estimated_hours"/>
                                    <field name="stage_id"/>

                                    <button
                                        name="action_remove_from_milestone"
                                        type="object"
                                        string="Remove"
                                        icon="fa-times"
                                        class="btn-link"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Milestone Search View -->
    <record id="view_project_milestone_search_custom" model="ir.ui.view">
        <field name="name">project.milestone.search.custom</field>
        <field name="model">project.milestone</field>
        <field name="arch" type="xml">
            <search string="Search Milestones">
                <field name="name"/>
                <field name="project_id"/>
                <field name="deadline"/>
                <field name="state"/>

                <filter
                    name="todo"
                    string="To Do"
                    domain="[('state', '=', 'todo')]"
                />

                <filter
                    name="in_progress"
                    string="In Progress"
                    domain="[('state', '=', 'in_progress')]"
                />

                <filter
                    name="done"
                    string="Done"
                    domain="[('state', '=', 'done')]"
                />

                <separator/>

                <filter
                    name="deadline"
                    string="Deadline"
                    date="deadline"
                />

                <group expand="0" string="Group By">
                    <filter
                        name="group_by_project"
                        string="Project"
                        context="{'group_by': 'project_id'}"
                    />

                    <filter
                        name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />

                    <filter
                        name="group_by_deadline"
                        string="Deadline"
                        context="{'group_by': 'deadline'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Milestone Action -->
    <record id="action_project_milestone_custom" model="ir.actions.act_window">
        <field name="name">Milestones</field>
        <field name="res_model">project.milestone</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_project_milestone_search_custom"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first project milestone
            </p>
            <p>
                Milestones help track project progress and organize tasks by delivery phases.
            </p>
        </field>
    </record>
</odoo>