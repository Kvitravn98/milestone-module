<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_report_project_status" model="ir.actions.report">
        <field name="name">Project Status Report</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">milestones_module.report_project_status_document</field>
        <field name="report_file">milestones_module.report_project_status_document</field>
        <field name="binding_model_id" ref="project.model_project_project"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">form</field>
        <field name="print_report_name">'Project Status - %s' % object.name</field>
    </record>

    <template id="report_project_status_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="project">
                <t t-call="web.external_layout">
                    <div class="page">

                        <style>
                            .ms-report-title {
                                margin-bottom: 4px;
                                color: #3f2c6d;
                                font-size: 26px;
                                font-weight: 700;
                            }

                            .ms-report-subtitle {
                                margin-bottom: 18px;
                                color: #666666;
                                font-size: 14px;
                            }

                            .ms-section-title {
                                margin-top: 26px;
                                margin-bottom: 10px;
                                padding-bottom: 4px;
                                border-bottom: 2px solid #6f42c1;
                                color: #3f2c6d;
                                font-size: 18px;
                                font-weight: 700;
                            }

                            .ms-card {
                                margin-bottom: 16px;
                                padding: 12px;
                                border: 1px solid #dddddd;
                                border-radius: 6px;
                                background-color: #ffffff;
                            }

                            .ms-card-title {
                                margin-bottom: 8px;
                                color: #3f2c6d;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            .ms-muted {
                                color: #777777;
                            }

                            .ms-small {
                                font-size: 12px;
                            }

                            .ms-summary-table th {
                                background-color: #f3f0fa;
                                color: #3f2c6d;
                                text-align: center;
                            }

                            .ms-summary-table td {
                                text-align: center;
                                font-size: 16px;
                                font-weight: 600;
                            }

                            .ms-info-table td {
                                padding: 5px 8px;
                            }

                            .ms-info-label {
                                width: 16%;
                                background-color: #f7f7f7;
                                color: #555555;
                                font-weight: 700;
                            }

                            .ms-task-table th {
                                background-color: #f3f0fa;
                                color: #3f2c6d;
                            }

                            .ms-task-table td,
                            .ms-task-table th {
                                vertical-align: middle;
                            }

                            .ms-number {
                                text-align: right;
                                white-space: nowrap;
                            }

                            .ms-badge {
                                display: inline-block;
                                padding: 3px 8px;
                                border-radius: 10px;
                                background-color: #eee8f8;
                                color: #3f2c6d;
                                font-size: 11px;
                                font-weight: 700;
                            }
                        </style>

                        <h1 class="ms-report-title">Project Status Report</h1>
                        <div class="ms-report-subtitle">
                            <span t-field="project.name"/>
                        </div>

                        <table class="table table-sm table-bordered ms-info-table">
                            <tbody>
                                <tr>
                                    <td class="ms-info-label">Project Manager</td>
                                    <td>
                                        <span t-field="project.user_id"/>
                                    </td>
                                    <td class="ms-info-label">Customer</td>
                                    <td>
                                        <span t-field="project.partner_id"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h2 class="ms-section-title">Milestone Summary</h2>

                        <table class="table table-sm table-bordered ms-summary-table">
                            <thead>
                                <tr>
                                    <th>Total Milestones</th>
                                    <th>Completed Milestones</th>
                                    <th>Progress</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <span t-field="project.custom_milestone_count"/>
                                    </td>
                                    <td>
                                        <span t-field="project.custom_completed_milestone_count"/>
                                    </td>
                                    <td>
                                        <span t-field="project.custom_milestone_progress"/>
                                        %
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h2 class="ms-section-title">Milestones and Tasks</h2>

                        <t t-if="project.milestone_ids">
                            <t t-foreach="project.milestone_ids" t-as="milestone">

                                <div class="ms-card">
                                    <div class="ms-card-title">
                                        <span t-field="milestone.name"/>
                                        <span class="ms-badge">
                                            <span t-field="milestone.state"/>
                                        </span>
                                    </div>

                                    <table class="table table-sm table-bordered ms-info-table">
                                        <tbody>
                                            <tr>
                                                <td class="ms-info-label">Deadline</td>
                                                <td>
                                                    <span t-field="milestone.deadline"/>
                                                </td>
                                                <td class="ms-info-label">Assigned Tasks</td>
                                                <td>
                                                    <span t-field="milestone.assigned_task_count"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                    <t t-if="milestone.task_ids">
                                        <table class="table table-sm table-bordered ms-task-table">
                                            <thead>
                                                <tr>
                                                    <th>Task</th>
                                                    <th>Assignees</th>
                                                    <th class="ms-number">Estimated Hours</th>
                                                    <th>Stage</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="milestone.task_ids" t-as="task">
                                                    <td>
                                                        <strong>
                                                            <span t-field="task.name"/>
                                                        </strong>
                                                    </td>
                                                    <td>
                                                        <t t-if="task.user_ids">
                                                            <span t-out="', '.join(task.user_ids.mapped('name'))"/>
                                                        </t>
                                                        <t t-if="not task.user_ids">
                                                            <span class="ms-muted">Unassigned</span>
                                                        </t>
                                                    </td>
                                                    <td class="ms-number">
                                                        <span t-field="task.estimated_hours"/>
                                                    </td>
                                                    <td>
                                                        <span t-field="task.stage_id"/>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </t>

                                    <t t-if="not milestone.task_ids">
                                        <p class="ms-muted ms-small">
                                            No tasks assigned to this milestone.
                                        </p>
                                    </t>
                                </div>

                            </t>
                        </t>

                        <t t-if="not project.milestone_ids">
                            <p class="ms-muted">
                                No milestones defined for this project.
                            </p>
                        </t>

                        <h2 class="ms-section-title">Team Allocation</h2>

                        <t t-if="project.team_member_ids">
                            <t t-foreach="project.team_member_ids" t-as="member">

                                <div class="ms-card">
                                    <div class="ms-card-title">
                                        <span t-field="member.user_id"/>
                                        <span class="ms-badge">
                                            <span t-field="member.role"/>
                                        </span>
                                    </div>

                                    <table class="table table-sm table-bordered ms-info-table">
                                        <tbody>
                                            <tr>
                                                <td class="ms-info-label">Assigned Tasks</td>
                                                <td>
                                                    <span t-field="member.task_count"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                    <t t-if="member.task_ids">
                                        <table class="table table-sm table-bordered ms-task-table">
                                            <thead>
                                                <tr>
                                                    <th>Task</th>
                                                    <th>Milestone</th>
                                                    <th class="ms-number">Estimated Hours</th>
                                                    <th>Stage</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="member.task_ids" t-as="task">
                                                    <td>
                                                        <strong>
                                                            <span t-field="task.name"/>
                                                        </strong>
                                                    </td>
                                                    <td>
                                                        <t t-if="task.milestone_id">
                                                            <span t-field="task.milestone_id"/>
                                                        </t>
                                                        <t t-if="not task.milestone_id">
                                                            <span class="ms-muted">No milestone</span>
                                                        </t>
                                                    </td>
                                                    <td class="ms-number">
                                                        <span t-field="task.estimated_hours"/>
                                                    </td>
                                                    <td>
                                                        <span t-field="task.stage_id"/>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </t>

                                    <t t-if="not member.task_ids">
                                        <p class="ms-muted ms-small">
                                            No tasks assigned to this team member.
                                        </p>
                                    </t>
                                </div>

                            </t>
                        </t>

                        <t t-if="not project.team_member_ids">
                            <p class="ms-muted">
                                No team members assigned to this project.
                            </p>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>